#!/bin/bash
set -euo pipefail

CONFIG_ROOT="${XDG_CONFIG_HOME:-$HOME/.config}/openai-environments"
DATA_ROOT="${XDG_DATA_HOME:-$HOME/.local/share}/openai-environments"
STATE_ROOT="${XDG_STATE_HOME:-$HOME/.local/state}/openai-environments"
PROFILE_ROOT="$DATA_ROOT/profiles"
CURRENT_FILE="$CONFIG_ROOT/current"
LOCK_DIR="$DATA_ROOT/.switch-lock"
LOG_FILE="$STATE_ROOT/switch.log"
APP_PATH="/Applications/ChatGPT.app"

ACTIVE_DIRS=(
  "$HOME/.codex"
  "$HOME/Library/Application Support/Codex"
  "$HOME/Library/HTTPStorages/com.openai.codex"
)
STATE_NAMES=(
  "codex-home"
  "app-support"
  "http-storage"
)
ACTIVE_COOKIE="$HOME/Library/HTTPStorages/com.openai.codex.binarycookies"

usage() {
  cat <<'EOF'
Usage: openai-env work|personal|status

  work      Activate the preserved corporate Mono/LUMI environment.
  personal  Activate an isolated environment with no work credentials or config.
  status    Show the active environment without displaying credentials.

Run work/personal from a normal Terminal window. The ChatGPT app will close and reopen.
EOF
}

log_only() {
  printf '[%s] %s\n' "$(date '+%Y-%m-%d %H:%M:%S %z')" "$*" >> "$LOG_FILE"
}

say() {
  printf '%s\n' "$*"
  log_only "$*"
}

die() {
  printf 'openai-env: %s\n' "$*" >&2
  log_only "ERROR: $*"
  exit 1
}

current_profile() {
  # A newly bootstrapped Mac starts clean unless explicitly switched to work.
  local profile="personal"
  if [[ -r "$CURRENT_FILE" ]]; then
    profile="$(tr -d '[:space:]' < "$CURRENT_FILE")"
  fi
  case "$profile" in
    work|personal) printf '%s\n' "$profile" ;;
    *) die "invalid profile marker: $profile" ;;
  esac
}

stored_path() {
  local profile="$1"
  local name="$2"
  printf '%s/%s/%s\n' "$PROFILE_ROOT" "$profile" "$name"
}

path_exists() {
  [[ -e "$1" || -L "$1" ]]
}

app_running() {
  pgrep -x 'ChatGPT' >/dev/null 2>&1 ||
    pgrep -f '^/Applications/ChatGPT.app/Contents/MacOS/ChatGPT([[:space:]]|$)' >/dev/null 2>&1
}

stop_app() {
  app_running || return 0

  say 'Closing ChatGPT before switching profiles...'
  osascript -e 'tell application "ChatGPT" to quit' >/dev/null 2>&1 ||
    osascript -e 'tell application id "com.openai.codex" to quit' >/dev/null 2>&1 ||
    osascript -e 'tell application "/Applications/ChatGPT.app" to quit' >/dev/null 2>&1 || true

  local attempt
  for attempt in {1..40}; do
    if ! app_running; then
      sleep 1
      return 0
    fi
    sleep 0.2
  done

  say 'ChatGPT did not respond to the normal quit request; sending it a terminate signal...'
  local main_pids
  main_pids="$(pgrep -x 'ChatGPT' 2>/dev/null || true)"
  if [[ -n "$main_pids" ]]; then
    kill -TERM $main_pids >/dev/null 2>&1 || true
  fi

  for attempt in {1..40}; do
    if ! app_running; then
      sleep 1
      return 0
    fi
    sleep 0.2
  done

  die "ChatGPT is still running. Quit it manually and retry. Details: $LOG_FILE"
}

clear_launch_environment() {
  local name
  for name in \
    LUMI_API_KEY LUMI_AUTH_TOKEN LUMI_BASE_URL \
    OPENAI_API_KEY OPENAI_BASE_URL OPENAI_ORGANIZATION OPENAI_PROJECT; do
    launchctl unsetenv "$name" >/dev/null 2>&1 || true
  done
}

apply_launch_environment() {
  local profile="$1"
  clear_launch_environment

  [[ "$profile" == "work" ]] || return 0

  set +u
  [[ -r "$CONFIG_ROOT/work.zsh" ]] && source "$CONFIG_ROOT/work.zsh"
  [[ -r "$HOME/.codex/lumi-env" ]] && source "$HOME/.codex/lumi-env"
  set -u

  local name value
  for name in \
    LUMI_API_KEY LUMI_AUTH_TOKEN LUMI_BASE_URL \
    OPENAI_API_KEY OPENAI_BASE_URL OPENAI_ORGANIZATION OPENAI_PROJECT; do
    value="$(printenv "$name" 2>/dev/null || true)"
    if [[ -n "$value" ]]; then
      launchctl setenv "$name" "$value" >/dev/null 2>&1 ||
        log_only "WARNING: could not set launch environment variable $name"
    fi
  done

  return 0
}

write_current_profile() {
  local profile="$1"
  local marker
  mkdir -p "$CONFIG_ROOT"
  marker="$(mktemp "$CONFIG_ROOT/current.XXXXXX")"
  printf '%s\n' "$profile" > "$marker"
  chmod 600 "$marker"
  mv "$marker" "$CURRENT_FILE"
}

move_recorded() {
  local from="$1"
  local to="$2"
  mkdir -p "$(dirname "$to")"
  mv "$from" "$to"
  printf '%s|%s\n' "$from" "$to" >> "$JOURNAL"
}

rollback_moves() {
  [[ -s "$JOURNAL" ]] || return 0
  local from to
  tail -r "$JOURNAL" | while IFS='|' read -r from to; do
    if path_exists "$to" && ! path_exists "$from"; then
      mkdir -p "$(dirname "$from")"
      mv "$to" "$from" || true
    fi
  done
}

prepare_target_profile() {
  local profile="$1"
  local index target
  mkdir -p "$PROFILE_ROOT/$profile"
  for index in 0 1 2; do
    target="$(stored_path "$profile" "${STATE_NAMES[$index]}")"
    path_exists "$target" || mkdir -p "$target"
  done
}

assert_current_storage_empty() {
  local profile="$1"
  local index stored cookie
  for index in 0 1 2; do
    stored="$(stored_path "$profile" "${STATE_NAMES[$index]}")"
    path_exists "$stored" && die "profile state is inconsistent: $stored already exists"
  done
  cookie="$(stored_path "$profile" 'http-cookies')"
  path_exists "$cookie" && die "profile state is inconsistent: $cookie already exists"
  return 0
}

switch_profile() {
  local desired="$1"
  local current index active stored target current_cookie target_cookie
  current="$(current_profile)"

  if [[ "$desired" == "$current" ]]; then
    apply_launch_environment "$current"
    printf 'OpenAI environment is already %s.\n' "$current"
    open "$APP_PATH" >/dev/null 2>&1 ||
      printf 'Profile is active; open ChatGPT manually if needed.\n'
    return 0
  fi

  if [[ -n "${CODEX_THREAD_ID:-}" || -n "${CODEX_SESSION_ID:-}" ]]; then
    die "run this switch from macOS Terminal, not from a terminal inside ChatGPT/Codex"
  fi

  mkdir -p "$CONFIG_ROOT" "$PROFILE_ROOT" "$DATA_ROOT"
  mkdir "$LOCK_DIR" 2>/dev/null || die "another switch may be running (lock: $LOCK_DIR)"

  JOURNAL="$(mktemp /private/tmp/openai-env-switch.XXXXXX)"
  trap 'rc=$?; if [[ $rc -ne 0 ]]; then log_only "ERROR: switch failed with exit code $rc; rolling back"; rollback_moves; fi; rm -f "$JOURNAL"; rmdir "$LOCK_DIR" 2>/dev/null || true; exit $rc' EXIT

  prepare_target_profile "$desired"
  assert_current_storage_empty "$current"
  stop_app

  for index in 0 1 2; do
    active="${ACTIVE_DIRS[$index]}"
    path_exists "$active" || mkdir -p "$active"
    stored="$(stored_path "$current" "${STATE_NAMES[$index]}")"
    move_recorded "$active" "$stored"
  done

  current_cookie="$(stored_path "$current" 'http-cookies')"
  if path_exists "$ACTIVE_COOKIE"; then
    move_recorded "$ACTIVE_COOKIE" "$current_cookie"
  fi

  for index in 0 1 2; do
    active="${ACTIVE_DIRS[$index]}"
    target="$(stored_path "$desired" "${STATE_NAMES[$index]}")"
    move_recorded "$target" "$active"
  done

  target_cookie="$(stored_path "$desired" 'http-cookies')"
  if path_exists "$target_cookie"; then
    move_recorded "$target_cookie" "$ACTIVE_COOKIE"
  fi

  write_current_profile "$desired"
  apply_launch_environment "$desired"

  trap - EXIT
  rm -f "$JOURNAL"
  rmdir "$LOCK_DIR" 2>/dev/null || true

  printf 'Activated %s OpenAI environment.\n' "$desired"
  if [[ "$desired" == "personal" && ! -s "$HOME/.codex/auth.json" ]]; then
    printf 'ChatGPT/Codex has no saved personal login and should ask you to sign in.\n'
  fi
  open "$APP_PATH" >/dev/null 2>&1 ||
    printf 'Profile switched successfully; open ChatGPT manually.\n'
  return 0
}

show_status() {
  local profile auth provider launch_state
  profile="$(current_profile)"

  if [[ -s "$HOME/.codex/auth.json" ]]; then
    auth="saved credentials present"
  else
    auth="signed out"
  fi

  if [[ -r "$HOME/.codex/config.toml" ]] && grep -q 'model_provider[[:space:]]*=[[:space:]]*"lumi"' "$HOME/.codex/config.toml"; then
    provider="LUMI corporate gateway"
  else
    provider="standard/personal configuration"
  fi

  if [[ -n "$(launchctl getenv LUMI_API_KEY 2>/dev/null || true)" ]]; then
    launch_state="corporate variables loaded"
  else
    launch_state="corporate variables absent"
  fi

  printf 'Profile:     %s\n' "$profile"
  printf 'Login:       %s\n' "$auth"
  printf 'Provider:    %s\n' "$provider"
  printf 'App launch:  %s\n' "$launch_state"
  printf 'Log:         %s\n' "$LOG_FILE"
}

mkdir -p "$CONFIG_ROOT" "$PROFILE_ROOT/work" "$PROFILE_ROOT/personal"
if mkdir -p "$STATE_ROOT" 2>/dev/null && touch "$LOG_FILE" 2>/dev/null; then
  chmod 600 "$LOG_FILE" 2>/dev/null || true
else
  LOG_FILE="/dev/null"
fi
log_only "openai-env ${1:-help}"

case "${1:-}" in
  work) switch_profile work ;;
  personal) switch_profile personal ;;
  status) show_status ;;
  -h|--help|help|'') usage ;;
  *) usage >&2; exit 2 ;;
esac
