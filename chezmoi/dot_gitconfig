[core]
  editor = code --wait

[pull]
  ff = only

[push]
  autoSetupRemote = true

[fetch]
  prune = true

[rerere]
  enabled = true

[branch]
  sort = -committerdate

[diff]
  tool = vscode

[difftool "vscode"]
  cmd = code --wait --diff "$LOCAL" "$REMOTE"

[difftool]
  prompt = false

[merge]
  tool = vscode

[mergetool "vscode"]
  cmd = code --wait "$MERGED"

[mergetool]
  prompt = false
  keepBackup = false

[alias]
  p = push
  pl = pull

  sw = switch
  swc = switch -c

  a = add -A
  c = commit
  cm = commit -m
  can = commit --amend --no-edit

  ac = !git add -A && git commit
  acm = !git add -A && git commit -m
  acan = !git add -A && git commit --amend --no-edit

  st = status --short --branch
  last = log -1 HEAD --stat
  d = diff

  br = branch --format='%(HEAD) %(color:yellow)%(refname:short)%(color:reset) - %(contents:subject) %(color:green)(%(committerdate:relative)) %(color:bold blue)[%(authorname)]'

  lg = log --graph --decorate --pretty=format:'%C(red)%h%Creset %C(yellow)%d%Creset %s %C(green)(%cr)%Creset %C(bold blue)[%an]%Creset' --abbrev-commit

  cfg = config --list --show-origin
  cfgg = config --global --list
  cfgl = config --local --list

  type = cat-file -t
  dump = cat-file -p

[url "https://github.com/dracula/"]
  insteadOf = dracula://

[color]
  ui = auto

[include]
  path = ~/.gitconfig.local