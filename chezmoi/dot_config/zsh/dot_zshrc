# History
HISTFILE="$XDG_STATE_HOME/zsh/history"
HISTSIZE=100000
SAVEHIST=100000

setopt APPEND_HISTORY
setopt SHARE_HISTORY
setopt HIST_IGNORE_DUPS
setopt HIST_IGNORE_SPACE
setopt HIST_EXPIRE_DUPS_FIRST
setopt HIST_FIND_NO_DUPS

# Shell behaviour
setopt AUTOCD
setopt NOBEEP
setopt NUMERIC_GLOB_SORT  # sort file10 after file9, not after file1

# Load config files
zsh_config_files=(
  path
  fzf
  aliases
  functions
  tools
  completion
  highlighting
  autosuggestions
)

for zsh_config_file in "${zsh_config_files[@]}"; do
  config_path="$ZDOTDIR/$zsh_config_file.zsh"
  [[ -r "$config_path" ]] && source "$config_path"
done

# Machine-specific environment variables and secrets.
[[ -r "$ZDOTDIR/secrets.zsh" ]] &&
  source "$ZDOTDIR/secrets.zsh"

unset zsh_config_files zsh_config_file config_path
